		minimal_driver_salary:	80	# fixed part of driver's pay
		driver_revenue_coef_per_km: 0.03		# Revenue coefficient used during quick job and drivers jobs.
		driver_cargo_market_revenue_coef_per_km: 0.018 # Revenue coefficient used during cargo market jobs for drivers.

		driver_hire_cost: 3000		# $

		free_driver_level_cap: 30	# don't grow offered drivers higher than this level
		driver_offer_scrap_prob: 0.5

		driver_quitwarn_time: 3		# days
		driver_quit_time: 5		# days
		driver_no_return_job_prob: 0.05	# 10% of no return job, decrease with skill

		driver_skilled_job_prob: 0.8

		##
		## Skill job filtering
		##

		fixed_revenue: 100	# in $
		revenue_coef_per_km: 0.07 # Revenue coefficient per km used during freight market jobs.
